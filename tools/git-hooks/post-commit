#!/bin/sh
progress_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if [ ! -r "$progress_root/tools/git-hooks/_lib.sh" ]; then
    exit 0
fi
. "$progress_root/tools/git-hooks/_lib.sh"
progress_head=$(git rev-parse HEAD 2>/dev/null) || exit 0
progress_record "$progress_head" '' 'commit 已完成'
exit 0
