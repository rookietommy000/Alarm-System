#!/bin/sh
progress_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -r "$progress_root/tools/git-hooks/_lib.sh" ] || exit 0
. "$progress_root/tools/git-hooks/_lib.sh"

# Use Git's stdin ref updates, NOT HEAD (push may target another branch).
# For multiple refs, select the newest candidate by committer timestamp.
progress_remote=${1-}
progress_latest=$(
    while read -r local_ref local_oid remote_ref remote_oid; do
        case "$local_oid" in (*[!0]*) ;; (*) continue ;; esac
        local_commit=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null) || continue
        if git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
            candidate=$(git rev-list -1 "$local_commit" "^$remote_oid" 2>/dev/null)
        else
            # New remote ref / unknown remote object: exclude locally known
            # refs for this remote; no fetch or network access from the hook.
            candidate=$(git rev-list -1 "$local_commit" --not "--remotes=$progress_remote" 2>/dev/null)
        fi
        [ -n "$candidate" ] || continue
        git show -s --format='%ct %H' "$candidate" 2>/dev/null
    done | sort -rn | head -n 1
)
progress_hash=${progress_latest#* }
[ -n "$progress_hash" ] || exit 0
progress_record "$progress_hash" 'push 嘗試（pre-push，尚未確認成功）' 'push 尚未確認成功'
exit 0
